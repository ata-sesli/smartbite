# ==============================================================================
# SmartBite Environment Configuration Example
# Copy this file to .env before starting the services:
#   cp .env.example .env
# ==============================================================================

# Application & Network
SMARTBITE_ENVIRONMENT=dev
SMARTBITE_LOG_LEVEL=INFO
SMARTBITE_API_PORT=8005

# Database & Cache (Default ports mapped by docker-compose)
# For running natively on host connecting to docker services:
SMARTBITE_DATABASE_URL=postgresql+asyncpg://smartbite:smartbite@localhost:15432/smartbite
SMARTBITE_REDIS_URL=redis://localhost:16379/0

# Storage
SMARTBITE_STORAGE_ROOT=data/storage

# Pipeline Runtime Backends
# mobile expiry detector: 'ultralytics' or 'onnx'
SMARTBITE_MOBILE_EXPIRY_DETECTOR_BACKEND=ultralytics
# SVTRv2 recognition: 'paddle' or 'onnx'
SMARTBITE_SVTRV2_REC_BACKEND=paddle
# SVTRv2 device mode: 'cpu', 'cuda', 'mps', or 'auto'
SMARTBITE_SVTRV2_DEVICE_MODE=cpu
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True

# Processing & Timeouts
SMARTBITE_ONE_SHOT_TIMEOUT_SECONDS=45.0
SMARTBITE_SCAN_JOB_EXPIRES_SECONDS=86400
SMARTBITE_ALERT_THRESHOLD_DAYS=3

# Model Weights & Hugging Face Repository
SMARTBITE_MODELS_HF_REPO_ID=atasesli/smartbite-models
SMARTBITE_MODELS_AUTO_DOWNLOAD=true

# Model Weights Paths (Local filesystem paths)
SMARTBITE_DETECTOR_MODEL_PATH=models/yolo20n/yolo26s/yolo26s-best.pt
SMARTBITE_MOBILE_EXPIRY_DETECTOR_MODEL_PATH=models/yolo26s_obb_expdate2k_ft_after_brazil/weights/best.pt
SMARTBITE_MOBILE_EXPIRY_DETECTOR_ONNX_PATH=models/yolo26s_obb_expdate2k_ft_after_brazil/weights/best.onnx
SMARTBITE_SVTRV2_REC_MODEL_DIR=models/svtrv2/smartbite_svtrv2_expdate_rec
SMARTBITE_SVTRV2_REC_ONNX_PATH=models/svtrv2/smartbite_svtrv2_expdate_rec_onnx/model.onnx
SMARTBITE_CONTEXT_SVTRV2_REC_MODEL_DIR=models/svtrv2/ch_SVTRv2_rec
SMARTBITE_PARSEQ_MODEL_DIR=models/parseq-small
SMARTBITE_EXPIRY_PROBE_MOBILE_REC_MODEL_DIR=models/ppocrv5/mobile_rec

# Strict model validation on startup (set to false to boot API without all model weights present)
SMARTBITE_MODEL_STARTUP_STRICT_VALIDATION=true
