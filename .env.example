SMARTBITE_APP_NAME=smartbite
SMARTBITE_ENVIRONMENT=dev
SMARTBITE_LOG_LEVEL=INFO
SMARTBITE_API_PORT=8005
SMARTBITE_ONE_SHOT_TIMEOUT_SECONDS=45
SMARTBITE_POSTGRES_PORT=15432
SMARTBITE_REDIS_PORT=16379

SMARTBITE_DATABASE_URL=postgresql+asyncpg://smartbite:smartbite@localhost:15432/smartbite
SMARTBITE_REDIS_URL=redis://localhost:16379/0

SMARTBITE_STORAGE_ROOT=data/storage
SMARTBITE_MAX_UPLOAD_SIZE_BYTES=10485760
SMARTBITE_ACCEPTED_FILE_TYPES=image/jpeg,image/png,image/webp
SMARTBITE_ACCEPTED_FILE_EXTENSIONS=.jpg,.jpeg,.png,.webp

SMARTBITE_ALERT_THRESHOLD_DAYS=3
SMARTBITE_SCAN_RETRY_COUNT=3

SMARTBITE_DETECTOR_MODEL_PATH=models/yolo20n/yolo26s/yolo26s-best.pt
SMARTBITE_PIPELINE_HIGH_RECALL_MODE=true
SMARTBITE_DETECTOR_TOP_K=4
SMARTBITE_DETECTOR_BOX_PADDING_RATIO=0.12
SMARTBITE_DETECTOR_CONFIDENCE_THRESHOLD=0.15
SMARTBITE_PARSER_MIN_CANDIDATE_CONFIDENCE=0.40

SMARTBITE_TEXT_DETECTOR_MODE=ensemble
SMARTBITE_EXPIRY_RECOGNIZER=svtrv2
SMARTBITE_SVTRV2_REC_MODEL_NAME=ch_SVTRv2_rec
SMARTBITE_SVTRV2_REC_MODEL_DIR=models/svtrv2/ch_SVTRv2_rec
SMARTBITE_SVTRV2_DEVICE_MODE=cpu
# Deprecated runtime backend, retained for benchmarks/comparison.
SMARTBITE_PARSEQ_MODEL_DIR=models/parseq-small
SMARTBITE_PARSEQ_HF_REPO_ID=baudm/parseq-small
SMARTBITE_PARSEQ_HF_REVISION=main
SMARTBITE_PARSEQ_DEVICE_MODE=cpu

SMARTBITE_OCR_PPOCRV5_USE_CUSTOM_TEXT_DET_MODEL=true
SMARTBITE_OCR_PPOCRV5_TEXT_DET_MODEL_NAME=PP-OCRv5_server_det
# Exported PP-OCRv5 detection inference directory used inside YOLO ROI.
# Do not point this to a raw model.pdparams checkpoint file.
SMARTBITE_OCR_PPOCRV5_TEXT_DET_MODEL_DIR=models/pp-ocrv5-text-detection/best_model_inference
SMARTBITE_OCR_PPOCRV5_USE_ANGLE_CLS=true
SMARTBITE_OCR_PPOCRV5_DET_DB_THRESH=0.25
SMARTBITE_OCR_PPOCRV5_DET_DB_BOX_THRESH=0.35
SMARTBITE_OCR_PPOCRV5_DET_LIMIT_SIDE_LEN=1216
SMARTBITE_OCR_PPOCRV5_DET_LIMIT_TYPE=max
SMARTBITE_OCR_PPOCRV5_DET_DB_UNCLIP_RATIO=1.8
SMARTBITE_OCR_PADDLE_LANG=en
SMARTBITE_CRAFT_ENABLED=true
SMARTBITE_CRAFT_MODEL_PATH=models/craft/craft_mlt_25k.pth
SMARTBITE_CRAFT_TEXT_THRESHOLD=0.7
SMARTBITE_CRAFT_LINK_THRESHOLD=0.4
SMARTBITE_CRAFT_LOW_TEXT=0.4
SMARTBITE_CRAFT_CANVAS_SIZE=1280
SMARTBITE_CRAFT_MAG_RATIO=1.5
SMARTBITE_CRAFT_VARIANT_NAMES=raw
SMARTBITE_CRAFT_RESCUE_ENABLED=true
SMARTBITE_CRAFT_RESCUE_VARIANT_NAME=raw
SMARTBITE_CRAFT_RESCUE_CANVAS_SIZE=640
SMARTBITE_CRAFT_RESCUE_MAG_RATIO=1.0
SMARTBITE_CRAFT_MAX_ROIS_PER_SCAN=1
SMARTBITE_CRAFT_MAX_BOXES_ACCEPTED=40
SMARTBITE_CRAFT_TRIGGER_MIN_PPOCR_BOXES=3
SMARTBITE_CRAFT_TRIGGER_MIN_BEST_SCORE=1.6
SMARTBITE_CRAFT_TRIGGER_LARGE_BOX_AREA_RATIO=0.15
SMARTBITE_CRAFT_TIMEOUT_SECONDS=12.0
SMARTBITE_EXPIRY_FILTER_GEOMETRY_TOP_N=12
SMARTBITE_EXPIRY_FILTER_FINAL_TOP_K=4
SMARTBITE_EXPIRY_GLOBAL_PROBE_TOP_K=20
SMARTBITE_EXPIRY_GLOBAL_FINAL_TOP_K=6
SMARTBITE_EXPIRY_GLOBAL_DEBUG_FINAL_TOP_K=12
SMARTBITE_EXPIRY_GLOBAL_MAX_PER_ROI=2
SMARTBITE_EXPIRY_GLOBAL_MAX_PER_VARIANT=3
SMARTBITE_EXPIRY_MAX_DETECTOR_VARIANTS=1
SMARTBITE_EXPIRY_DETECTOR_VARIANTS=raw
SMARTBITE_EXPIRY_MAX_ROIS_PER_SCAN=1
SMARTBITE_EXPIRY_PROBE_VARIANTS=original_padded,clahe_gray,adaptive_binary
SMARTBITE_EXPIRY_PARSEQ_VARIANT_POLICY=best_probe
SMARTBITE_EXPIRY_PARSEQ_MAX_VARIANTS_PER_CANDIDATE=1
SMARTBITE_EXPIRY_DEBUG_ALL_RECOGNITION_VARIANTS=false
SMARTBITE_EXPIRY_FINAL_CROP_PADDING_RATIO=0.04
SMARTBITE_EXPIRY_FINAL_CROP_MIN_PADDING_PX=3
SMARTBITE_EXPIRY_FINAL_CROP_MAX_PADDING_PX=18
SMARTBITE_EXPIRY_DEBUG_PARSEQ_WHOLE_GROUPS=false
SMARTBITE_MAX_GROUP_CANDIDATES_PER_ROI=100
SMARTBITE_EXPIRY_PROBE_REC_MODEL_NAME=PP-OCRv5_mobile_rec
SMARTBITE_EXPIRY_PROBE_MOBILE_REC_MODEL_DIR=models/ppocrv5/mobile_rec
SMARTBITE_EXPIRY_PROBE_MOBILE_REC_HF_REPO_ID=PaddlePaddle/PP-OCRv5_mobile_rec
SMARTBITE_EXPIRY_PROBE_MOBILE_REC_HF_REVISION=main
# Kept for prefetch compatibility; intentionally unused in runtime pipeline for this phase.
SMARTBITE_EXPIRY_PROBE_MOBILE_DET_MODEL_DIR=models/ppocrv5/mobile_det
SMARTBITE_EXPIRY_PROBE_MOBILE_DET_HF_REPO_ID=PaddlePaddle/PP-OCRv5_mobile_det
SMARTBITE_EXPIRY_PROBE_MOBILE_DET_HF_REVISION=main
SMARTBITE_EXPIRY_DEBUG_SAVE_CANDIDATES=true
SMARTBITE_EXPIRY_DEBUG_SAVE_OVERLAYS=true

SMARTBITE_GENERAL_TEXT_OCR_TIMEOUT_SECONDS=45

SMARTBITE_MODEL_STARTUP_STRICT_VALIDATION=true
# Optional Paddle runtime flag (also enforced in code): disable model hoster connectivity check.
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True

SMARTBITE_WEBHOOK_STUB_URL=http://localhost:9999/webhook/alerts
