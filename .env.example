SMARTBITE_APP_NAME=smartbite
SMARTBITE_ENVIRONMENT=dev
SMARTBITE_LOG_LEVEL=INFO
SMARTBITE_API_PORT=8005
SMARTBITE_POSTGRES_PORT=15432
SMARTBITE_REDIS_PORT=16379

SMARTBITE_DATABASE_URL=postgresql+asyncpg://smartbite:smartbite@localhost:15432/smartbite
SMARTBITE_REDIS_URL=redis://localhost:16379/0

SMARTBITE_STORAGE_ROOT=data/storage
SMARTBITE_MAX_UPLOAD_SIZE_BYTES=10485760
SMARTBITE_ACCEPTED_FILE_TYPES=image/jpeg,image/png,image/webp
SMARTBITE_ACCEPTED_FILE_EXTENSIONS=.jpg,.jpeg,.png,.webp

SMARTBITE_ALERT_THRESHOLD_DAYS=3
SMARTBITE_SCAN_RETRY_COUNT=3

SMARTBITE_DETECTOR_MODEL_PATH=yolo26n.pt
SMARTBITE_OCR_PPOCRV5_MAIN_MODEL_DIR=models/fine-tuned-models/best_model_inference
SMARTBITE_OCR_PPOCRV5_MAIN_CHAR_DICT_PATH=ppocr/utils/dict/ppocrv5_dict.txt
SMARTBITE_OCR_PPOCRV5_USE_ANGLE_CLS=true
SMARTBITE_OCR_PPOCRV5_DET_DB_THRESH=0.3
SMARTBITE_OCR_PPOCRV5_DET_DB_BOX_THRESH=0.5
SMARTBITE_OCR_PADDLE_LANG=en
SMARTBITE_OCR_DEVICE_MODE=auto
SMARTBITE_OCR_SUBSTITUTE_CONFIG_PATH=app/ai/ocr_substitute_config.json
SMARTBITE_OCR_ENABLE_SUBSTITUTE_MODEL=false
# Optional Paddle runtime flag (also enforced in code): disable model hoster connectivity check.
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True

SMARTBITE_WEBHOOK_STUB_URL=http://localhost:9999/webhook/alerts
